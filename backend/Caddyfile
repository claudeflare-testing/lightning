# FrankenPHP: web server + runtime PHP + hub Mercure, tutto in un binario.
# In prod sostituisci :80 con il tuo dominio per avere HTTPS automatico.

{
	# Ordine dei direttivi per il modulo Mercure/php.
	frankenphp
	order php_server before file_server
	order mercure after encode
}

tuodominio.it {
	log

	# --- Hub Mercure integrato ---
	mercure {
		# DEVE combaciare con MERCURE_JWT_SECRET del backend.
		publisher_jwt {env.MERCURE_JWT_SECRET}
		subscriber_jwt {env.MERCURE_JWT_SECRET}
		# In dev puoi aprire anonymous; in prod meglio il cookie via /api/realtime/config.
		anonymous
		# CORS per la SPA React servita da altro origin (in dev).
		cors_origins http://localhost:5173
	}

	root * /var/www/lightning/backend/public
	encode zstd br gzip

	# La SPA React viene buildata e servita a parte (Nginx/Caddy separato o
	# CDN). Qui sta solo l'API PHP. Se vuoi servire anche la SPA da qui,
	# aggiungi un blocco file_server puntato alla dist di Vite.
	php_server
}
