# Copia in .env.local e adatta i valori.

APP_ENV=prod
APP_SECRET=cambia_con_una_stringa_casuale_lunga

# --- PostgreSQL (archivio privato) ---
# PostGIS opzionale ma consigliato per query per raggio.
DATABASE_URL="postgresql://lightning:password@127.0.0.1:5432/lightning?serverVersion=16&charset=utf8"

# --- Redis (buffer live + coda archivio) ---
REDIS_DSN=redis://127.0.0.1:6379

# --- Mercure (incluso in FrankenPHP) ---
# In prod l'hub gira dentro FrankenPHP su /.well-known/mercure.
MERCURE_URL=http://127.0.0.1/.well-known/mercure
MERCURE_PUBLIC_URL=https://tuodominio.it/.well-known/mercure
# Devono combaciare con quelli nel Caddyfile.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# --- Bounding box zona di interesse (default: Italia) ---
BOX_MIN_LAT=35.0
BOX_MAX_LAT=47.5
BOX_MIN_LON=6.0
BOX_MAX_LON=19.0

# Finestra buffer live (secondi)
LIVE_WINDOW_SECONDS=900
